# Banco de dados (desenvolvimento local)
POSTGRES_DB=amarelo
POSTGRES_USER=amarelo
POSTGRES_PASSWORD=amarelo
DATABASE_URL=postgresql+asyncpg://amarelo:amarelo@postgres:5432/amarelo

# Armazenamento S3 (LocalStack)
S3_ENDPOINT_URL=http://s3:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=raw-data
S3_REGION=us-east-1

# Coleta Olho Vivo — credencial privada, usada somente pelo coletor
OLHOVIVO_TOKEN=
COLLECTION_INTERVAL_SECONDS=30
COLLECTION_TIMEOUT_SECONDS=5
# Opcional: endpoint HTTPS que recebe JSON de alerta. Deixar vazio até definir o canal.
COLLECTION_ALERT_WEBHOOK=

# GTFS — download direto da SPTrans; não colocar credenciais em VITE_*
GTFS_SOURCE_URL=https://www.sptrans.com.br/umbraco/Surface/PerfilDesenvolvedor/BaixarGTFS
GTFS_SOURCE_ID=sptrans
GTFS_INTERVAL_SECONDS=86400
GTFS_FAILURE_INTERVAL_SECONDS=300
GTFS_TIMEOUT_SECONDS=60
GTFS_ATTEMPTS=3
GTFS_MAX_BYTES=268435456
GTFS_MAX_EXPANDED_BYTES=4294967296

# Mapa ao vivo US22 — adaptador privado da API
OLHO_VIVO_TOKEN=
OLHO_VIVO_BASE_URL=https://api.olhovivo.sptrans.com.br/v2.1
# Exportação para o mapa; deixar vazio enquanto o produtor não estiver integrado.
NETWORK_CATALOG_PATH=
