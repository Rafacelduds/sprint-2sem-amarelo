# Banco de dados (desenvolvimento local)
POSTGRES_DB=amarelo
POSTGRES_USER=amarelo
POSTGRES_PASSWORD=amarelo
DATABASE_URL=postgresql+asyncpg://amarelo:amarelo@postgres:5432/amarelo

# Armazenamento S3 (LocalStack)
S3_ENDPOINT_URL=http://s3:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=raw-data
S3_REGION=us-east-1

# Coleta Olho Vivo — credencial privada, usada somente pelo coletor
OLHOVIVO_TOKEN=
COLLECTION_INTERVAL_SECONDS=30
COLLECTION_TIMEOUT_SECONDS=5
# Opcional: endpoint HTTPS que recebe JSON de alerta. Deixar vazio até definir o canal.
COLLECTION_ALERT_WEBHOOK=

# US32: destino local independente; no host, usar http://localhost:4567.
BACKUP_S3_ENDPOINT_URL=http://s3-backup:4566
BACKUP_S3_ACCESS_KEY=test
BACKUP_S3_SECRET_KEY=test
BACKUP_S3_BUCKET=backup-data
APP_CODE_VERSION=
# Após restaurar: caminho do mapa gerado, para resolver versões e buckets antigos.
# S3_RESTORE_MAP=
# RESTORE_DATABASE_URL=postgresql+asyncpg://usuario:senha@host:5432/banco_vazio

