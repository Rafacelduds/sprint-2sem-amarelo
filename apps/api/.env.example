# Banco de dados (desenvolvimento local)
POSTGRES_DB=amarelo
POSTGRES_USER=amarelo
POSTGRES_PASSWORD=amarelo
DATABASE_URL=postgresql+asyncpg://amarelo:amarelo@postgres:5432/amarelo

# Armazenamento S3 (LocalStack)
S3_ENDPOINT_URL=http://s3:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=raw-data
S3_REGION=us-east-1

# Olho Vivo — credencial privada compartilhada entre coletor e API do mapa
# Também configura o mapa. Aliases aceitos: OLHOVIVO_TOKEN e OLHO_VIVO_TOKEN.
CHAVE_API_OLHO_VIVO=
COLLECTION_INTERVAL_SECONDS=30
COLLECTION_TIMEOUT_SECONDS=5
# Opcional: endpoint HTTPS que recebe JSON de alerta. Deixar vazio até definir o canal.
COLLECTION_ALERT_WEBHOOK=

# US32: destino local independente; no host, usar http://localhost:4567.
BACKUP_S3_ENDPOINT_URL=http://s3-backup:4566
BACKUP_S3_ACCESS_KEY=test
BACKUP_S3_SECRET_KEY=test
BACKUP_S3_BUCKET=backup-data
APP_CODE_VERSION=
# Após restaurar: caminho do mapa gerado, para resolver versões e buckets antigos.
# S3_RESTORE_MAP=
# RESTORE_DATABASE_URL=postgresql+asyncpg://usuario:senha@host:5432/banco_vazio

# GTFS — download direto da SPTrans; não colocar credenciais em VITE_*
GTFS_SOURCE_URL=https://www.sptrans.com.br/umbraco/Surface/PerfilDesenvolvedor/BaixarGTFS
GTFS_SOURCE_ID=sptrans
GTFS_INTERVAL_SECONDS=86400
GTFS_FAILURE_INTERVAL_SECONDS=300
GTFS_TIMEOUT_SECONDS=60
GTFS_ATTEMPTS=3
GTFS_MAX_BYTES=268435456
GTFS_MAX_EXPANDED_BYTES=4294967296

# Mapa ao vivo US22 — adaptador privado da API
# O token compartilhado é configurado acima; não precisa repeti-lo aqui.
OLHO_VIVO_BASE_URL=https://api.olhovivo.sptrans.com.br/v2.1
# Vazio: consumir automaticamente o GTFS já capturado pela US02.
# Definir somente para substituir a fonte por uma exportação explícita.
NETWORK_CATALOG_PATH=
# Cache derivado descartável; padrão: data/network na raiz do projeto.
# NETWORK_CACHE_DIR=

# US04 — programação oficial; substituir apenas em testes ou fonte autorizada.
SCHEDULE_SOURCE_URL=https://itinerariosapi.sptrans.com.br
