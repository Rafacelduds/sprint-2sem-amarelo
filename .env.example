# Banco de dados (desenvolvimento local)
POSTGRES_DB=amarelo
POSTGRES_USER=amarelo
POSTGRES_PASSWORD=amarelo
DATABASE_URL=postgresql+asyncpg://amarelo:amarelo@postgres:5432/amarelo

# Armazenamento S3 (LocalStack)
S3_ENDPOINT_URL=http://s3:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=raw-data
S3_REGION=us-east-1

# Frontend — variáveis VITE_* são públicas no navegador; nunca colocar tokens aqui
VITE_API_URL=/api

# Coleta Olho Vivo — credencial privada, usada somente pelo coletor
OLHOVIVO_TOKEN=
COLLECTION_INTERVAL_SECONDS=30

